#!/usr/bin/env bash

NO_EMAIL=false
LIST=false #change 1 - if no -l in args , LIST is not initialized  so the program dont know the variable
FILE=""

while [[ $# -gt 0 ]]; do
  case $1 in
    -l|--list )
      LIST=true
      shift
      ;;
    --no-email )
      NO_EMAIL=true
      shift
      ;;
    * )
	break
   
  esac
done
#change 1 : $LIST --> "$LIST"

if [ "$LIST" != true ]; then   #flag not activated--> mode not print to the terminal
  FILE=$1
  if [ -z "$FILE" ]; then  #if FILE is empty 
    FILE=$(find . -mindepth 1 -maxdepth 1 \( -iname '*authors*' -o -iname '*contributors*' \) | head -n1)
    if [ -z "$FILE" ]; then
      FILE='AUTHORS'
    fi
  fi
fi

#
# list authors sorted by number of commits (descending).
#

authors() {
  if $NO_EMAIL; then
    # email will be used to uniq authors.
    git shortlog HEAD -sne | awk '{$1=""; sub(" ", ""); print}' | awk -F'<' '!x[$1]++' | awk -F'<' '!x[$2]++' \
      | awk -F'<' '{gsub(/ +$/, "", $1); print $1}'
  else
    git shortlog HEAD -sne | awk '{$1=""; sub(" ", ""); print}' | awk -F'<' '!x[$1]++' | awk -F'<' '!x[$2]++'
  fi
}

#
# authors.
#
echo "">>"$FILE" 
if  $LIST; then
  authors
else
  authors >> "$FILE" &&  sort "$FILE" | uniq > tmp && mv tmp "$FILE"   #to remove double names
fi



# if the command have not flag --npt-email so i let write the name in the file authors even if in the file there was only name
#without email
